<?xml version="1.0" encoding="utf-8"?>
<!--
  LYNX's MSIX package manifest for the Microsoft Store (round 165n, docs/STORE.md).
  scripts/make-msix-layout.py fills the @...@ fields: the identity comes from Partner Center (Product identity page),
  through the repository variables MSIX_IDENTITY_NAME, MSIX_PUBLISHER and MSIX_PUBLISHER_DISPLAY.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LYNX</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Free, open-source digital audio workstation with a pattern-based workflow.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="LYNX" Executable="LYNX.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="LYNX" Description="Free, open-source digital audio workstation"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" ShortName="LYNX" />
      </uap:VisualElements>
      <Extensions>
        <!-- `lynx` on the command line (and the release workflow's packaged self-test) -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="LYNX.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="lynx.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- LYNX projects; FL Studio projects and MIDI files are only offered in "Open with" (Windows keeps the
             current default program) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="lynxproject">
            <uap:DisplayName>LYNX Project</uap:DisplayName>
            <uap:Logo>Assets\ProjectFile.png</uap:Logo>
            <uap:InfoTip>LYNX project</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/x-lynx-project">.lynx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="flproject">
            <uap:DisplayName>FL Studio project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.flp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="midifile">
            <uap:DisplayName>MIDI file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="audio/midi">.mid</uap:FileType>
              <uap:FileType ContentType="audio/midi">.midi</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- recording from a microphone / audio interface (Windows asks the user once) -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
